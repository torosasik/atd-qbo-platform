{
  "name": "atd-qbo-platform",
  "version": "1.0.0",
  "description": "ATD QuickBooks Online Automation Platform",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "deploy": "firebase deploy",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "emulate": "firebase emulators:start",
    "test": "npm run test:frontend && npm run test:functions",
    "test:frontend": "cd frontend && npm test -- --run",
    "test:functions": "cd functions && npm test",
    "test:e2e": "playwright test",
    "test:e2e:flows": "playwright test tests/e2e/flows",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.js",
    "test:e2e:a11y": "playwright test tests/e2e/a11y.spec.js",
    "test:e2e:update": "playwright test tests/e2e/visual.spec.js --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e"
  },
  "author": "American Tile Depot",
  "license": "PRIVATE",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1"
  }
}
