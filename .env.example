# ATD QBO Platform - Environment Variables Reference
#
# These are NOT used directly as .env values.
# Set them via Firebase Functions config:
#
#   firebase functions:config:set qbo.client_id="..."
#   firebase functions:config:set qbo.client_secret="..."
#   firebase functions:config:set claude.api_key="..."
#
# For local development with the Firebase emulator, create a file at:
#   functions/.runtimeconfig.json
# with the structure below (this file is gitignored):
#
# {
#   "qbo": {
#     "client_id": "your_intuit_client_id",
#     "client_secret": "your_intuit_client_secret"
#   },
#   "claude": {
#     "api_key": "your_claude_api_key"
#   }
# }
#
# The GOOGLE_APPLICATION_CREDENTIALS variable is only needed if you run
# Cloud Functions outside the Firebase emulator (e.g. direct node execution).
# The emulator handles auth automatically.
#
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
